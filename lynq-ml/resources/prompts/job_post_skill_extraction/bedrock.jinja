Example 1

Title:
Senior Backend Java Developer

Description:
Building scalable backend services using Java. Experience with asynchronous communication, REST APIs, SQL databases and AWS.

Output

{
  "skills": [
    "Java",
    "Spring",
    "Maven",
    "Kafka",
    "RabbitMQ",
    "REST",
    "SQL",
    "AWS",
    "Docker",
    "Git"
  ],
  "similarity_tags": [
    "Backend Development",
    "Asynchronous Messaging",
    "API Development",
    "Relational Databases",
    "Cloud Infrastructure",
    "Containerization",
    "Object Oriented Programming",
    "Version Control"
  ]
}

