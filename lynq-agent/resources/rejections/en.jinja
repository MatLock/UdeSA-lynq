{% set sections = {'summary': 'the summary', 'work_experience': 'the experience', 'skills': 'the skills'} %}
{% set kinds = {'unknown_entry': 'the resume has no such job and CV Tailor cannot add jobs', 'unjudged': 'the judge gave no verdict on it', 'cut': 'the proposal left out something the resume already has', 'moved': 'the proposal changed the order the resume has', 'unbacked': 'neither the resume nor what you told me names that skill'} %}
{% set judged = {'language': 'the proposal changed the language of the resume', 'dropped_content': 'the proposal left out something the resume already has', 'reordered': 'the proposal changed the order the resume has', 'dropped_skill': 'the proposal dropped a skill the resume already has', 'invented': 'the proposal said something neither the resume nor what you told me backs', 'unsupported_skill': 'neither the resume nor what you told me names that skill', 'wording': 'the proposed wording did not improve the resume', 'padding': 'the proposal added filler with no content'} %}
{% set unexplained = 'the judge rejected it without saying why' %}
{{ 'Nothing of what was proposed entered the resume:' if nothing_applied else 'Part of what was proposed did not enter the resume:' }} {% for r in rejections %}{{ sections.get(r.section, r.section) }}{% if r.label %} ({{ r.label }}){% endif %}, {% if r.kind in kinds %}{{ kinds[r.kind] }}{% elif r.reason and r.reason != r.kind %}{{ r.reason }}{% else %}{{ judged.get(r.kind, unexplained) }}{% endif %}{% if r.kind == 'unknown_entry' and r.known_entries %} (its jobs are: {{ r.known_entries | join('; ') }}){% endif %}{% if not loop.last %}; {% endif %}{% endfor %}.
